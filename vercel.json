{
  "buildCommand": "npm install && npm run build -w frontend",
  "outputDirectory": "frontend/build",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sjg-backend.onrender.com/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
